# Copy to .env.local and fill in. Never commit real values.
# Server-only: none of these may be prefixed NEXT_PUBLIC_.

# The owner: the only admin. The account is created (or updated) from these when the app starts.
# OWNER_PASSWORD_HASH is Better Auth's scrypt hash of the password, never the password itself. Make one with:
#   node --input-type=module -e "import {hashPassword} from 'better-auth/crypto'; console.log(await hashPassword(process.argv[1]))" 'your password'
# Changing it changes the owner's password and signs the owner out everywhere.
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD_HASH=

# Secrets: long random values, e.g. `openssl rand -base64 48`. SESSION_SECRET signs sign-in sessions.
SESSION_SECRET=
CRON_SECRET=

# The site's address. Optional: any localhost port works locally, and Vercel's production address is used there.
BETTER_AUTH_URL=

# "Continue with Google" (see docs/GOOGLE-SIGN-IN.md). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database. Leave empty locally to use the built-in PGlite database in .data/pglite.
# On Vercel, set it to the Neon connection string.
DATABASE_URL=

# Minutes between automatic job searches triggered by opening the app (default 10).
REFRESH_MINUTES=

# Later phases
# AI assistant in the resume editor (server-only). Get a key at aistudio.google.com.
GEMINI_API_KEY=
# Optional: which Gemini model to use (default gemini-2.5-flash).
GEMINI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
