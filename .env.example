# Copy to .env.local and fill in. Never commit real values.
# Server-only: none of these may be prefixed NEXT_PUBLIC_.

# Setup password + secrets. Set these with `npm run set-password` (stores a scrypt hash, never the password).
# APP_PASSWORD_HASH is used once, on /setup, to create the owner (admin) account. SESSION_SECRET signs sign-in sessions.
APP_PASSWORD_HASH=
SESSION_SECRET=
CRON_SECRET=

# The site's address. Optional: any localhost port works locally, and Vercel's production address is used there.
BETTER_AUTH_URL=

# "Continue with Google" (see docs/GOOGLE-SIGN-IN.md). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database. Leave empty locally to use the built-in PGlite database in .data/pglite.
# On Vercel, set it to the Neon connection string.
DATABASE_URL=

# Minutes between automatic job searches triggered by opening the app (default 10).
REFRESH_MINUTES=

# Later phases
# AI assistant in the resume editor (server-only). Get a key at aistudio.google.com.
GEMINI_API_KEY=
# Optional: which Gemini model to use (default gemini-2.5-flash).
GEMINI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
