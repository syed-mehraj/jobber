# Copy to .env.local and fill in. Never commit real values.
# Server-only: none of these may be prefixed NEXT_PUBLIC_.

# Sign-in. Set these with `npm run set-password` (stores a scrypt hash, never the password).
APP_PASSWORD_HASH=
SESSION_SECRET=
CRON_SECRET=

# Database. Leave empty locally to use the built-in PGlite database in .data/pglite.
# On Vercel, set it to the Neon connection string.
DATABASE_URL=

# Minutes between automatic job searches triggered by opening the app (default 10).
REFRESH_MINUTES=

# Later phases
# AI assistant in the resume editor (server-only). Get a key at aistudio.google.com.
GEMINI_API_KEY=
# Optional: which Gemini model to use (default gemini-2.5-flash).
GEMINI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
