#!/bin/sh
# Blocks commits that contain anything shaped like a secret or a phone number.
# Enable once per clone:  git config core.hooksPath .githooks
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

fail=0
for f in $staged; do
  case "$f" in
    .env.example|.githooks/pre-commit) continue ;;
    .env|.env.*) echo "blocked: $f is an env file"; fail=1; continue ;;
  esac
  added=$(git diff --cached -U0 -- "$f" | grep '^+' | grep -v '^+++')
  echo "$added" | grep -Eq 'AIza[0-9A-Za-z_-]{30,}' && { echo "blocked: Google/Gemini API key in $f"; fail=1; }
  echo "$added" | grep -Eq '[0-9]{8,10}:[A-Za-z0-9_-]{35}' && { echo "blocked: Telegram bot token in $f"; fail=1; }
  echo "$added" | grep -Eq 'postgres(ql)?://[^:/ ]+:[^@ ]+@' && { echo "blocked: database URL with a password in $f"; fail=1; }
  echo "$added" | grep -Eq -- '-----BEGIN [A-Z ]*PRIVATE KEY-----' && { echo "blocked: private key in $f"; fail=1; }
  echo "$added" | grep -Eiq '(api[_-]?key|secret|token|password)["'"'"' ]*[:=] *["'"'"'][^"'"'"' ]{12,}' && { echo "blocked: hard-coded credential in $f"; fail=1; }
  echo "$added" | grep -Eq '(\+91[ -]?)?[6-9][0-9]{4}[ -]?[0-9]{5}' && { echo "blocked: phone number in $f"; fail=1; }
done
[ $fail -eq 1 ] && echo "Commit stopped. Move the value to .env.local or Vercel settings." && exit 1
exit 0
